<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Café Express"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="30dp"
        android:textStyle="bold"
        android:layout_marginTop="30dp"

        />
    <TextView
        android:id="@+id/titre2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="prise de commande"
        app:layout_constraintTop_toBottomOf="@+id/titre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        />
    <TextView
        android:id="@+id/cafe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cafe"
        app:layout_constraintTop_toBottomOf="@+id/titre2"
        app:layout_constraintStart_toStartOf="parent"
        android:textSize="20dp"
        android:layout_margin="30dp"
        android:textStyle="bold"
        />
    <TextView
        android:id="@+id/espresso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Espresso"
        app:layout_constraintTop_toBottomOf="@+id/cafe"
        app:layout_constraintStart_toStartOf="@+id/cafe"
        android:textSize="20dp"
        android:layout_marginTop="50dp"
        android:textStyle="bold"
        />
    <TextView
        android:id="@+id/criossant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Croissant"
        app:layout_constraintTop_toBottomOf="@+id/espresso"
        app:layout_constraintStart_toStartOf="@+id/espresso"
        android:textSize="20dp"
        android:layout_marginTop="50dp"
        android:textStyle="bold"
        />
    <TextView
        android:id="@+id/prix1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10dh"
        app:layout_constraintBaseline_toBaselineOf="@+id/cafe"
        app:layout_constraintStart_toEndOf="@+id/criossant"
        android:layout_margin="30dp"
        />
    <TextView
        android:id="@+id/prix2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="8dh"
        app:layout_constraintBaseline_toBaselineOf="@+id/espresso"
        app:layout_constraintStart_toStartOf="@id/prix1"
        />
    <TextView
        android:id="@+id/prix3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="6dh"
        app:layout_constraintBaseline_toBaselineOf="@+id/criossant"
        app:layout_constraintStart_toStartOf="@id/prix1"
        />

    <Button
        android:id="@+id/btnAddCafe"
        android:layout_width="60dp"
        android:layout_height="50dp"
        android:text="-"
        app:layout_constraintBaseline_toBaselineOf="@+id/prix1"
        app:layout_constraintStart_toEndOf="@id/prix1"
        android:layout_marginLeft="25dp"/>
    <TextView
        android:id="@+id/countCofe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        app:layout_constraintBaseline_toBaselineOf="@+id/prix1"
        app:layout_constraintStart_toEndOf="@id/btnAddCafe"
        android:layout_marginLeft="30dp"
        android:textStyle="bold"
        android:textSize="20dp"/>
    <Button
        android:id="@+id/btnRemoveCafe"
        android:layout_width="60dp"
        android:layout_height="50dp"
        android:text="+"
        app:layout_constraintBaseline_toBaselineOf="@+id/prix1"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <Button
        android:id="@+id/btnAddEspresso"
        android:layout_width="60dp"
        android:layout_height="50dp"
        android:text="-"
        app:layout_constraintBaseline_toBaselineOf="@+id/prix2"
        app:layout_constraintStart_toEndOf="@id/prix1"
        android:layout_marginLeft="25dp"/>
    <TextView
        android:id="@+id/countEspresso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        app:layout_constraintBaseline_toBaselineOf="@+id/prix2"
        app:layout_constraintStart_toEndOf="@id/btnAddEspresso"
        android:layout_marginLeft="30dp"
        android:textStyle="bold"
        android:textSize="20dp"/>
    <Button
        android:id="@+id/btnRemoveEspresso"
        android:layout_width="60dp"
        android:layout_height="50dp"
        android:text="+"
        app:layout_constraintBaseline_toBaselineOf="@+id/prix2"
        app:layout_constraintEnd_toEndOf="parent"
       />
    <Button
        android:id="@+id/btnAddCroissant"
        android:layout_width="60dp"
        android:layout_height="50dp"
        android:text="-"
        app:layout_constraintBaseline_toBaselineOf="@+id/prix3"
        app:layout_constraintStart_toEndOf="@id/prix1"
        android:layout_marginLeft="25dp"/>
    <TextView
        android:id="@+id/countCroissant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        app:layout_constraintBaseline_toBaselineOf="@+id/prix3"
        app:layout_constraintStart_toEndOf="@id/btnAddEspresso"
        android:layout_marginLeft="30dp"
        android:textStyle="bold"
        android:textSize="20dp"/>
    <Button
        android:id="@+id/btnRemoveCroissant"
        android:layout_width="60dp"
        android:layout_height="50dp"
        android:text="+"
        app:layout_constraintBaseline_toBaselineOf="@+id/prix3"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <TextView
        android:id="@+id/nomClient"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nom du client"
        app:layout_constraintTop_toBottomOf="@+id/criossant"
        app:layout_constraintStart_toStartOf="@+id/espresso"
        android:textSize="15dp"
        android:layout_marginTop="60dp"
        android:textStyle="italic"
        />
    <EditText
        android:id="@+id/etext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="EX:CHIHAB"

        app:layout_constraintTop_toBottomOf="@+id/nomClient"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="@id/btnRemoveCafe"/>

    <TextView
        android:id="@+id/total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="Total: 0 DH"
        android:textSize="30dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etext"
        />
    <Button
        android:id="@+id/vide"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="vider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
         android:layout_marginLeft="15dp"
        android:layout_marginBottom="20dp"/>
    <Button
        android:id="@+id/commnde"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:text="commnde"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginLeft="15dp"

        android:layout_marginBottom="20dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>